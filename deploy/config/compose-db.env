# compose-db.env — default DB credentials for the compose-INTERNAL Postgres
# (profiles postgres / node2 of deploy/docker-compose.yml and every node of
# deploy/docker-compose.cluster.yml): the same janus/janus Testcontainers
# convention the `postgres` service itself uses. NOT secrets — dev/demo
# defaults only; a real deployment never runs the compose-internal DB.
#
# Consumed via `env_file` (listed BEFORE ../.env — later env_file entries win,
# so a repo-root .env that defines any of these overrides this file, and no
# `environment:` entry exists to override both; see deploy/docker-compose.yml).
JANUS_DB_URL=jdbc:postgresql://postgres:5432/janus
JANUS_DB_USER=janus
JANUS_DB_PASS=janus
