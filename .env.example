# Janus environment variables (copy to .env and fill in as needed).
# Loaded by your shell or process manager — Janus itself reads Micronaut/system
# properties and standard env vars; no dotenv file is required at runtime.
# NEVER commit .env (gitignored).
# Live provider JUnit suite (env-gated, not part of ./gradlew build):
# JANUS_LIVE=1 ./gradlew :janus-gateway:liveTest
# See scripts/live-provider/README.md

# Master key for admin routes (auth ON when set). Generate a long random secret.
# JANUS_MASTER_KEY=

# Opt-in for live provider ITs (required in addition to provider keys).
# JANUS_LIVE=1

# Provider API keys (referenced from config.toml [[janus.model-list]] api-key-env — names only, never values).
# NOTE: Micronaut 5.1 binds record components from kebab-case TOML keys only —
# api_key_env / base_url (underscores) bind to null silently; use api-key-env / base-url.
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=

# Optional Postgres store. Leave unset for in-memory default. Referenced
# from config.toml [janus.store] via jdbc-url-env / user-env / password-env —
# the URL and credentials live HERE, never in the TOML file.
# JANUS_DB_URL=jdbc:postgresql://localhost:5432/janus
# JANUS_DB_USER=janus
# JANUS_DB_PASS=

# Server bind (overrides application.toml / config.toml)
# MICRONAUT_SERVER_PORT=8080
